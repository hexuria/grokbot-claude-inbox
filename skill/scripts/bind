#!/bin/sh
# Bind a session: write its env file from the routine's webhook URL and
# Authorization header, create its inbox, and prove the webhook with a
# self-test ping. Values are never printed, only their lengths.
#
# Usage:
#   ~/.grokbot/bind <session> --dialog        two Mac dialogs ask for the values
#   ~/.grokbot/bind <session> <<'GROKBOT_END' or read KEY=VALUE lines on stdin
#   WEBHOOK_URL=https://...
#   WEBHOOK_HEADER=Authorization: Bearer ...
#   PROJECT=/absolute/path
#   RULES=ask
#   ROUTINE=claude-<session>
#   GROKBOT_END
#
# PROJECT, RULES and ROUTINE may also come in as environment variables.
set -eu

[ $# -ge 1 ] || { echo 'usage: bind <session> [--dialog] (KEY=VALUE lines on stdin)' >&2; exit 2; }
session=$1
case $session in
  ''|*[!a-z0-9-]*) echo "bind: session must be kebab-case, got '$session'" >&2; exit 2 ;;
esac

url=${WEBHOOK_URL:-} header=${WEBHOOK_HEADER:-}
project=${PROJECT:-} rules=${RULES:-} routine=${ROUTINE:-}

if [ "${2:-}" = --dialog ]; then
  ask() {  # ask <prompt> <hidden|shown>
    hidden=''; [ "$2" = hidden ] && hidden='with hidden answer'
    osascript -e "text returned of (display dialog \"Session $session: $1\" default answer \"\" $hidden with title \"grokbot-claude-inbox\" buttons {\"Cancel\", \"OK\"} default button \"OK\")" \
      || { echo 'bind: dialog cancelled' >&2; exit 1; }
  }
  url=$(ask "paste the routine's webhook URL" shown)
  header=$(ask "paste the routine's full Authorization header" hidden)
else
  while IFS= read -r line || [ -n "$line" ]; do
    case $line in
      WEBHOOK_URL=*)    url=${line#WEBHOOK_URL=} ;;
      WEBHOOK_HEADER=*) header=${line#WEBHOOK_HEADER=} ;;
      PROJECT=*)        project=${line#PROJECT=} ;;
      RULES=*)          rules=${line#RULES=} ;;
      ROUTINE=*)        routine=${line#ROUTINE=} ;;
      ''|'#'*) ;;
      *) echo "bind: expected KEY=VALUE, got a line starting '${line%%=*}'" >&2; exit 2 ;;
    esac
  done
fi

# Trim whitespace, a stray carriage return, and one layer of quotes.
clean() {
  v=$(printf '%s' "$1" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')
  case $v in
    "'"*"'") v=${v#\'}; v=${v%\'} ;;
    '"'*'"') v=${v#\"}; v=${v%\"} ;;
  esac
  printf '%s' "$v"
}
url=$(clean "$url"); header=$(clean "$header")
project=$(clean "$project"); rules=$(clean "$rules"); routine=$(clean "$routine")

# Accept "Bearer <token>" or a bare token and complete the header.
case $header in
  *': '*) ;;
  'Bearer '*) header="Authorization: $header" ;;
  ?*) case $header in *' '*) ;; *) header="Authorization: Bearer $header" ;; esac ;;
esac

[ -n "$url" ] || { echo 'bind: WEBHOOK_URL is empty' >&2; exit 2; }
[ -n "$header" ] || { echo 'bind: WEBHOOK_HEADER is empty' >&2; exit 2; }
case $url in
  http://*|https://*) ;;
  *) echo 'bind: WEBHOOK_URL is not a URL' >&2; exit 2 ;;
esac
case $header in
  *' http'*|*':http'*) echo 'bind: WEBHOOK_HEADER holds a URL where the token belongs' >&2; exit 2 ;;
  ?*': '?*) ;;
  *) echo "bind: WEBHOOK_HEADER must look like 'Authorization: Bearer <token>'" >&2; exit 2 ;;
esac
[ "$url" != "$header" ] || { echo 'bind: the URL and the header are the same value' >&2; exit 2; }
case $rules in
  ''|ask|merge-when-green) ;;
  *) echo "bind: RULES must be ask or merge-when-green, got '$rules'" >&2; exit 2 ;;
esac
case $project in
  ''|/*) ;;
  *) echo "bind: PROJECT must be an absolute path, got '$project'" >&2; exit 2 ;;
esac

q() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }
g="$HOME/.grokbot"
umask 077
mkdir -p "$g/inbox"
chmod 700 "$g" "$g/inbox"
{
  printf 'WEBHOOK_URL=%s\n' "$(q "$url")"
  printf 'WEBHOOK_HEADER=%s\n' "$(q "$header")"
  [ -n "$project" ] && printf 'PROJECT=%s\n' "$(q "$project")"
  [ -n "$rules" ]   && printf 'RULES=%s\n' "$(q "$rules")"
  [ -n "$routine" ] && printf 'ROUTINE=%s\n' "$(q "$routine")"
  :
} > "$g/$session.env.tmp"
mv "$g/$session.env.tmp" "$g/$session.env"
touch "$g/inbox/$session.jsonl"
chmod 600 "$g/$session.env" "$g/inbox/$session.jsonl"
echo "bind: wrote $g/$session.env (URL ${#url} chars, header ${#header} chars) and created the inbox"

if printf 'relay self-test' | "$g/ping" "$session" update >/dev/null; then
  echo "bind: self-test ping delivered; $session is bound"
else
  echo "bind: self-test ping failed, so the webhook is not proven; check the URL and header, then run bind again" >&2
  exit 1
fi
