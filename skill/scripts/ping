#!/bin/sh
# Send a message from a Claude Code session to its Grok Bot webhook routine.
#
# Usage:
#   ~/.grokbot/ping <session> <need> <<'GROKBOT_END'
#   <message>
#   GROKBOT_END
#
# need: decision | merge | pr_ready | recap | update | blocker
# Reads WEBHOOK_URL and WEBHOOK_HEADER from ~/.grokbot/<session>.env.
# Needs curl 7.76 or newer and awk; runs under sh, bash, and Git Bash.
set -eu

json_string() {  # stdin -> one JSON string literal, without jq
  awk 'BEGIN { for (i = 1; i < 32; i++) ctl[sprintf("%c", i)] = sprintf("\\u%04x", i) }
    function esc(s,   out, i, c) {
      out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\\") out = out "\\\\"
        else if (c == "\"") out = out "\\\""
        else if (c == "\n") out = out "\\n"
        else if (c == "\r") out = out "\\r"
        else if (c == "\t") out = out "\\t"
        else if (c in ctl) out = out ctl[c]
        else out = out c
      }
      return out
    }
    { body = (NR > 1) ? body "\\n" esc($0) : esc($0) }
    END { printf "\"%s\"", body }'
}

[ $# -eq 2 ] || { echo 'usage: ping <session> <need> < message' >&2; exit 2; }
session=$1 need=$2

case $session in
  ''|*[!a-z0-9-]*) echo "ping: session must be kebab-case, got '$session'" >&2; exit 2 ;;
esac
case $need in
  decision|merge|pr_ready|recap|update|blocker) ;;
  *) echo "ping: unknown need '$need'" >&2; exit 2 ;;
esac

env_file="$HOME/.grokbot/$session.env"
[ -r "$env_file" ] || { echo "ping: $env_file not found; '$session' is not bound" >&2; exit 2; }
. "$env_file"
[ -n "${WEBHOOK_URL:-}" ] && [ -n "${WEBHOOK_HEADER:-}" ] ||
  { echo "ping: $env_file needs WEBHOOK_URL and WEBHOOK_HEADER" >&2; exit 2; }
case $WEBHOOK_URL in
  http://*|https://*) ;;
  *) echo "ping: WEBHOOK_URL in $env_file is not a URL" >&2; exit 2 ;;
esac
case $WEBHOOK_HEADER in
  *' http'*|*':http'*)
    echo "ping: WEBHOOK_HEADER in $env_file holds a URL where the token belongs" >&2; exit 2 ;;
  ?*': '?*) ;;
  *) echo "ping: WEBHOOK_HEADER in $env_file must look like 'Authorization: Bearer <token>'" >&2; exit 2 ;;
esac

message=$(cat)
[ -n "$message" ] || { echo 'ping: empty message' >&2; exit 2; }

body=$(printf '{"session":%s,"need":%s,"message":%s}' \
  "$(printf '%s' "$session" | json_string)" "$(printf '%s' "$need" | json_string)" \
  "$(printf '%s' "$message" | json_string)")

curl -sS --fail-with-body --max-time 30 "$WEBHOOK_URL" \
  -H "$WEBHOOK_HEADER" \
  -H 'Content-Type: application/json' \
  --data-binary "$body"
